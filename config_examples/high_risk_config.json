{
  "sequence_length_min": 20,
  "sequence_length_max": 80,
  "num_sequences": 300,
  "mutation_rate": 0.5,
  "num_mutants_per_base": 30,
  "sdc_detection": ["checksum", "redundant", "boundary", "canary"],
  "parallel_workers": 4,
  "batch_size": 30,
  "compress_output": true,
  
  "generation_strategies": {
    "random_combination": {
      "enabled": false,
      "weight": 0
    },
    "category_based": {
      "enabled": false,
      "weight": 0
    },
    "risk_based": {
      "enabled": true,
      "weight": 1.0,
      "risk_levels": ["high"]
    },
    "pattern_based": {
      "enabled": false,
      "weight": 0
    }
  },
  
  "mutation_strategies": {
    "replace": {
      "enabled": true,
      "probability": 0.3
    },
    "insert": {
      "enabled": true,
      "probability": 0.3
    },
    "delete": {
      "enabled": true,
      "probability": 0.1
    },
    "swap": {
      "enabled": true,
      "probability": 0.15
    },
    "duplicate": {
      "enabled": true,
      "probability": 0.15
    },
    "reverse": {
      "enabled": false,
      "probability": 0
    }
  },
  
  "sdc_detection_config": {
    "checksum": {
      "enabled": true,
      "algorithm": "sha256",
      "check_interval": 10
    },
    "redundant": {
      "enabled": true,
      "compare_method": "exact"
    },
    "boundary": {
      "enabled": true,
      "min_value": 0,
      "max_value": "UINT64_MAX"
    },
    "canary": {
      "enabled": true,
      "canary_value": "0xDEADBEEFCAFEBABE",
      "positions": ["stack", "heap", "registers"]
    }
  }
}
